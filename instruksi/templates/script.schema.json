{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video script (satu siklus)",
  "description": "Sumber tunggal untuk suara, caption, visual Remotion, dan render semua rasio.",
  "type": "object",
  "required": [
    "cycle",
    "title_options",
    "promise",
    "creator_evidence",
    "scenes",
    "shorts_cuts"
  ],
  "properties": {
    "cycle": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$",
      "description": "Nama folder siklus, misalnya 001-flutter-rebuilds"
    },
    "title_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "thumbnail_text": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 2
    },
    "promise": {
      "type": "string",
      "description": "Janji video dalam satu kalimat"
    },
    "creator_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "what",
          "scene_id"
        ],
        "properties": {
          "what": {
            "type": "string",
            "description": "Demo kode, data proyek, pengalaman, screen recording"
          },
          "scene_id": {
            "type": "string"
          },
          "source_path": {
            "type": "string",
            "description": "Path file kode atau rekaman nyata"
          }
        }
      }
    },
    "pronunciations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "say_as"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "say_as": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "narration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "role": {
            "enum": [
              "hook",
              "context",
              "body",
              "rehook",
              "payoff",
              "cta"
            ]
          },
          "narration": {
            "type": "object",
            "required": [
              "en"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          },
          "duration_ms": {
            "type": "object",
            "description": "Diisi setelah TTS",
            "properties": {
              "en": {
                "type": "integer"
              },
              "id": {
                "type": "integer"
              }
            }
          },
          "shots": {
            "type": "array",
            "description": "Satu shot per kalimat narasi Inggris (instruksi/referensi/gaya-visual.md bagian 6)",
            "items": {
              "type": "object",
              "required": [
                "sentence",
                "show",
                "motion"
              ],
              "properties": {
                "sentence": {
                  "type": "integer",
                  "minimum": 1
                },
                "show": {
                  "type": "string"
                },
                "scale": {
                  "enum": [
                    "map",
                    "place",
                    "object",
                    "inside"
                  ]
                },
                "motion": {
                  "type": "string"
                },
                "transition": {
                  "enum": [
                    "cut",
                    "iris",
                    "wipe",
                    "push",
                    "hold"
                  ]
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "text",
                      "word"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "word": {
                        "type": "string"
                      }
                    }
                  }
                },
                "count": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "as": {
                      "enum": [
                        "dots",
                        "items",
                        "timeline",
                        "split"
                      ]
                    }
                  }
                },
                "faces": {
                  "type": "object"
                },
                "mood": {
                  "type": "string"
                },
                "bubble": {
                  "type": "string"
                },
                "three_d": {
                  "type": "boolean",
                  "description": "Penanda informatif; 3D dipilih lewat import di 04-shots.tsx"
                }
              }
            }
          },
          "broll": {
            "description": "Footage nyata untuk scene dunia nyata: {keywords, avoid} atau {own} atau {lic}"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "claim"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "claim": {
                  "type": "string"
                },
                "id": {
                  "type": "string",
                  "pattern": "^C\\d{2,}$",
                  "description": "id klaim di tabel Riset fakta 01-riset-viral.md"
                }
              }
            }
          }
        }
      }
    },
    "shorts_cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "scene_ids",
          "hook_override"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "scene_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thumbnail": {
            "type": "object",
            "description": "Wajib untuk siklus baru: thumbnail tegak 1080x1920 Short ini (produksi/CONTRACT.md)",
            "required": [
              "lines",
              "stage"
            ],
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "stage": {
                "type": "object"
              }
            }
          },
          "hook_override": {
            "type": "string",
            "description": "Hook khusus versi pendek, maksimal 2 detik bicara"
          }
        }
      }
    },
    "anti_slop": {
      "type": "object",
      "properties": {
        "text_score_en": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "text_score_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    },
    "anchor": {
      "type": "object",
      "description": "Jangkar visual yang muncul berulang",
      "properties": {
        "kind": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        }
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pemeran dari produksi/STYLE.md"
    },
    "visual_spec": {
      "type": "string",
      "description": "Path relatif ke dokumen arah visual per scene (biasanya 03-visual.json, bentuk di $defs.visual). Wajib untuk siklus baru; menyalakan aturan V-1..V-9 (produksi/CONTRACT.md)."
    },
    "sources": {
      "type": "array",
      "description": "Ringkasan sumber tingkat atas (dihitung QA)",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "url",
              "claim"
            ],
            "properties": {
              "scene": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "pattern": "^C\\d{2,}$"
              }
            }
          },
          {
            "type": "string",
            "description": "URL polos, hanya siklus lama"
          }
        ]
      }
    },
    "chapters": {
      "type": "array",
      "description": "Chapter untuk deskripsi YouTube",
      "items": {
        "type": "object"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thumbnails": {
      "type": "array",
      "description": "Varian thumbnail A/B (produksi/CONTRACT.md)",
      "items": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array"
          },
          "stage": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "visual": {
      "title": "03-visual.json",
      "description": "Arah visual per scene (instruksi/referensi/gaya-visual.md bagian 3)",
      "type": "object",
      "required": [
        "scenes"
      ],
      "properties": {
        "cycle": {
          "type": "string"
        },
        "palette": {
          "type": "object"
        },
        "scenes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^s\\d{2}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/visual_scene"
          }
        },
        "version": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "visual_scene": {
      "type": "object",
      "required": [
        "purpose",
        "subjects",
        "environment",
        "composition",
        "animation",
        "pattern",
        "dimension"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pattern": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P\\d{2}$"
          }
        },
        "dimension": {
          "enum": [
            "2d",
            "2.5d",
            "3d"
          ]
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "treatment",
              "anatomy"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "treatment": {
                "enum": [
                  "literal",
                  "simplified",
                  "metaphor"
                ]
              },
              "anatomy": {
                "type": "string",
                "description": "Bagian yang bisa digambar, minimal 12 kata"
              },
              "scale_ref": {
                "type": "string"
              },
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C\\d{2,}$"
                }
              },
              "detail_level": {
                "enum": [
                  "L1",
                  "L2",
                  "L3"
                ]
              },
              "silhouette": {
                "type": "string"
              },
              "proportions": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "material": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "matte",
                      "glossy",
                      "translucent",
                      "liquid",
                      "glass",
                      "organic",
                      "membrane",
                      "metal",
                      "concrete",
                      "fabric",
                      "soil",
                      "vegetation",
                      "atmosphere"
                    ]
                  },
                  "surface": {
                    "type": "string"
                  },
                  "transparency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "highlight": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "required": [
            "setting"
          ],
          "properties": {
            "setting": {
              "type": "string"
            },
            "layers": {
              "type": "object",
              "properties": {
                "bg": {
                  "type": "string"
                },
                "env": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "fg": {
                  "type": "string"
                },
                "atmos": {
                  "type": "string"
                },
                "far": {
                  "type": "string"
                },
                "mid": {
                  "type": "string"
                }
              }
            },
            "palette": {
              "type": "string"
            },
            "lighting": {
              "type": "string"
            },
            "landmark": {
              "type": "string"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "life": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "behavior": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subject",
              "action"
            ],
            "properties": {
              "subject": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "interacts": {
                "type": "string"
              },
              "treatment": {
                "enum": [
                  "literal",
                  "simplified",
                  "metaphor"
                ]
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C\\d{2,}$"
                }
              }
            }
          }
        },
        "composition": {
          "type": "object",
          "properties": {
            "camera": {
              "type": "string"
            },
            "placement": {
              "type": "string"
            },
            "focal": {
              "type": "string"
            },
            "negative_space": {
              "type": "string"
            },
            "support": {
              "type": "string"
            }
          }
        },
        "animation": {
          "type": "object",
          "required": [
            "initial",
            "sequence",
            "final"
          ],
          "properties": {
            "initial": {
              "type": "string"
            },
            "sequence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "camera_move": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            },
            "transition": {
              "type": "string"
            },
            "final": {
              "type": "string"
            },
            "deformation": {
              "type": "string"
            }
          }
        },
        "simplifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "shots": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "needs": {
          "type": "string"
        },
        "light": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "key_color": {
              "type": "string"
            },
            "shadow_color": {
              "type": "string"
            },
            "fill": {
              "type": "string"
            },
            "rim": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string"
                },
                "side": {
                  "type": "string"
                }
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contact_shadows": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "art_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "want"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^T\\d{1,2}$"
              },
              "want": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
